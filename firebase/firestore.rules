rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Replace these UIDs with the Firebase Auth UID(s) of your real admin account(s).
    function isAdmin() {
      return signedIn() &&
        request.auth.uid in [
          "REPLACE_WITH_ADMIN_UID"
        ];
    }

    // Public customer website can read published marketing data.
    // Only admins can create/update/delete it.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Field-level checks are defense-in-depth: if an admin session is ever
    // phished or an admin's device is compromised, this limits what a
    // malicious write can contain (field names, types, and size) even
    // though the attacker already passed isAdmin().
    function validMenuItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','price','category','description','imageUrl','visible','soldOut'])
        && d.name is string && d.name.size() < 120
        && (!('description' in d) || (d.description is string && d.description.size() < 500))
        && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() < 500));
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMenuItem();
      allow delete: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Audit records are append-only for admins.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
